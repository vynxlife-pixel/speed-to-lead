# Copy this file to ".env" for local use. On Railway, enter these in each service's "Variables" tab.
# NEVER upload your real .env file to GitHub.

# --- General ---------------------------------------------------------------
ENVIRONMENT=development            # set to "production" on Railway
LOG_LEVEL=INFO
DISPLAY_TIMEZONE=UTC               # e.g. Asia/Kolkata, America/New_York

# --- Gemini AI (https://aistudio.google.com/apikey) -------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Supabase (Project Settings > API) --------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_KEY=              # the SECRET "service_role" key, never the anon/public key

# --- Webhook security -------------------------------------------------------
WEBHOOK_API_KEY=                   # make up a long random string (see README)
RATE_LIMIT_PER_MINUTE=60
ALLOWED_ORIGINS=                   # normally leave empty

# --- Email (https://resend.com) ---------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=Skyline Realty <onboarding@resend.dev>   # use your verified domain in production

# --- Hot lead alerts (optional) ---------------------------------------------
SLACK_WEBHOOK_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
AGENT_ALERT_PHONE=

# --- Dashboard service only -------------------------------------------------
BACKEND_URL=http://localhost:8000  # on Railway: your backend's public https URL
DASHBOARD_PASSWORD=                # required when ENVIRONMENT=production
